def Prix_Dupires_Utiles(K):
    # Meilleur prix de Dupire   
    res=int((K/dK))
    return res

def Levenberg_Maquardt(Vp, Kp):
    # Intialisation des données
    beta = [1, 1]
    d = [1, 1]
    k = 0
    eps = 10**(-5)
    lmbda = 0.001
    V_dupire = np.zeros(len(Vp))
    V_market = np.zeros(len(Vp))
    vega = np.zeros(len(Vp))
    residu = np.zeros(len(Vp))
    J = np.array([np.zeros(2) for i in range(len(Vp))])

    while linalg.norm(d) > eps:
        for p in range(len(Vp)):
            # Calcul de la volatilité locale
            sigma = [(beta[0] / (K[i]**beta[1])) for i in range(N+2)]
            # Calcul de volatilité local + h
            sigmah = [h + sigma[i] for i in range(N+2)]

            # Valeur de l'option selon la volatilité local
            V_surface = prix_dupire(sigma)
            V_dilate = prix_dupire(sigmah)
            # Valeur de l'option avec la volatilité selon les différentes valeurs du strike
            j = Prix_Dupires_Utiles(Kp[p])
            V_dupire[p] = V_surface[M+1][j]
            V_market[p] = V_dilate[M+1][j]
            
            # Vega dupire de l'espace discritisé
            vega[p] = -(V_dupire[p] - V_market[p]) / h

            # Stockage du résidus entre la marché moins la valeur selon la valeur de Dupire 
            residu[p] = Vp[p] - V_dupire[p]

            # Calcul du Jacobien
            J[p][0] = vega[p] / (Kp[p]**beta[1])
            J[p][1] = -vega[p] * np.log(Kp[p]) * beta[0] / (Kp[p]**beta[1])

        # Mise à jour des paramètres par calibration de Levenberg-Marquardt
        # Calcul de la direction de descente avec la matrice Hessienne
        d = np.dot(
            -linalg.inv(np.dot(J.transpose(), J) + lmbda * np.identity(2)),
            np.dot(J.transpose(), residu)
        )
        # Calcul du béta
        beta = beta + d.transpose()    
        k += 1  # Incrémentation du compteur

    print('Beta1 =', beta[0])
    print('Beta2 =', beta[1])
    print('Nombre d iterations :', k)


    # Graphiques
    plt.plot(Kp, Vp, 'o', label='V_marche')
    plt.plot(Kp, V_dupire, label='V_Dupire')
    plt.xlabel('K_marche')
    plt.ylabel('V')
    plt.title('Prix de marché - prix de dupire à T=T_max post calibration')
    plt.legend()
    plt.show()

    # Plot Pricing Call
    X1, Y1 = np.meshgrid(K, T)
    Z1 = np.array(V_surface)
    plt.rcParams["figure.figsize"] = [16, 9]
    plt.figure()
    ax = plt.axes(projection="3d")
    ax.plot_surface(X1, Y1, Z1, cmap=plt.cm.coolwarm, alpha=0.8)
    plt.title('Pricing Call EU post calibration')
    ax.set_xlabel('K')
    ax.set_ylabel('T')
    ax.set_zlabel('V(K,T)')
    plt.show()

    # Plot de la surface de volatilité du Vega 
    ZZ = np.subtract(np.array(V_dilate), np.array(V_surface)) / h
    Z1 = np.array(ZZ)
    plt.rcParams["figure.figsize"] = [16, 9]
    plt.figure()
    ax = plt.axes(projection="3d")
    ax.plot_surface(X1, Y1, Z1, cmap=plt.cm.coolwarm, alpha=0.8)
    plt.title('Pricing Vega Call 3D post calibration ')
    ax.set_xlabel('K')
    ax.set_ylabel('T')
    ax.set_zlabel('Vega')
    plt.show()



