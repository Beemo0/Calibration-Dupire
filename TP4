def Euler():

    # Condition initiale
    V = [[0 for j in range(N+2)] for i in range(M+2)]
    for i in range(N+2):
        V[0][i] = max(S0 - K[i], 0)

    # Conditions aux limites
    for n in range(M+2):
        V[n][0] = S0
        V[n][N+1] = 0
    
    # Euler
    for n in range(0, M+1):
        for i in range(1, N+1):

            dVdK = (V[n][i+1] - V[n][i-1])/(2*dK)
            d2VdK2 = (V[n][i+1] - 2*V[n][i] + V[n][i-1])/(dK**2)

            # Choix du sigma
            if isinstance(sigma_loc, (int, float)):
                sigma_val = sigma_loc
            elif sigma_loc.ndim == 1:
                sigma_val = sigma_loc[i]
            else:
                sigma_val = sigma_loc[n][i]

            # Calcul explicite du coursl
            V[n+1][i] = (
                V[n][i]
                + dT * (
                    -r*K[i] * dVdK
                    + 0.5 * (sigma_val)**2 * K[i]**2 * d2VdK2
                )
            )

    # Plot: Solution à T=Tmax et le payoff
    plt.plot(K, V[M+1], label="T = T_max")
    plt.plot(K, V[0], label="Payoff")
    plt.legend()
    plt.xlabel("Strike K")
    plt.ylabel("V(K,T)")
    plt.grid()
    plt.show()

    # Plot surface 3D
    fig = plt.figure()
    ax = fig.add_subplot(111, projection="3d")

    KK, TT = np.meshgrid(K, T)

    V_array = np.array(V)

    ax.plot_surface(KK, TT, V_array, cmap="viridis")
    ax.set_xlabel("K")
    ax.set_ylabel("T")
    ax.set_zlabel("V")
    plt.title("Surface de prix via Euler")
    plt.show()

    return V

