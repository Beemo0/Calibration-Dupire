def prix_dupire(sigma):
   
    # Condition initiale
    V = [[0 for j in range(N+2)] for i in range(M+2)]
    for i in range(N+2):
        V[0][i] = max(S0 - K[i], 0)

    # Conditions aux limites
    for n in range(M+2):
        V[n][0] = S0
        V[n][N+1] = 0
    
    #Crank-Nicolson

    # On initialise les tous les coefficients à 0
    A = [0 for i in range(N+1)]
    B = [0 for i in range(N+1)]
    D = [0 for i in range(N+1)]
    C = [[0 for j in range(N+1)] for i in range(M+1)]

    # Calcul des facteurs de l'équation de Crank-Nicolson
    for i in range(1,N+1): 
        A[i] = (dT/4)*(K[i]*r/dK - ((sigma[i]*K[i]/dK)**2))
        B[i] = -(dT/4)*(K[i]*r/dK + ((sigma[i]*K[i])/dK)**2)
        D[i] = 1 + (dT/2)*((sigma[i]*K[i]/dK)**2)
    
    # Initilisation de C* et D*
    Cstar = [[0 for j in range(N+1)] for i in range(M+1)]
    Dstar = np.zeros(N+1)
    
    # Algorithme de Thomas avec la méthode de Cn
    for n in range(M+1):
        for i in range(1,N+1):
            if i==1:
                # Cas spécial si notre i vaut 1 on rajoute S0 * B2
                C[n][i]=-(dT/4)*(K[i]*r/dK - ((sigma[i]**2) * (K[i]**2))/(dK**2))*V[n][i+1] + (1-dT/2*(sigma[i]**2)*(K[i]**2)/(dK**2))*V[n][i] + dT/4*(r*K[i]/dK + (sigma[i]**2) * (K[i]**2) /(dK**2))*V[n][i-1] - S0*B[2]
            else:
                C[n][i]=-(dT/4)*(K[i]*r/dK - ((sigma[i]**2) * (K[i]**2))/(dK**2))*V[n][i+1] + (1-dT/2*(sigma[i]**2)*(K[i]**2)/(dK**2))*V[n][i] + dT/4*(r*K[i]/dK + (sigma[i]**2) * (K[i]**2) /(dK**2))*V[n][i-1] 
        
        # Attribution des valeurs pour C et D
        Cstar[n][1] =  C[n][1] 
        Dstar[1] = D[1] 
        
        # Calcul des valeurs pour D* et C*
        for i in range(2,N+1):
            Dstar[i] = D[i] - (B[i] * A[i-1] / Dstar[i-1])
            Cstar[n][i] = C[n][i]- (B[i] * Cstar[n][i-1] / Dstar[i-1])
        
        # Valeur de l'actif actualisé
        V[n+1][N] = Cstar[n][N] / Dstar[N]
        
        # Cacul final de la valeur de l'actif
        for i in range(N-1,0,-1):
            V[n+1][i] = (Cstar[n][i] -A[i] * V[n+1][i+1])/ Dstar[i]
    return V

